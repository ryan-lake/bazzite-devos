[Unit]
Description=Restart user audio after AMD ACP mic modules load
After=default.target

[Service]
Type=oneshot
ExecStart=/usr/bin/bash -lc 'for attempt in {1..20}; do [[ -e /sys/bus/platform/devices/acp-pdm-mach/driver ]] && exit 0; sleep 0.5; done; exit 0'
ExecStart=/usr/bin/systemctl --user restart wireplumber pipewire pipewire-pulse

[Install]
WantedBy=default.target